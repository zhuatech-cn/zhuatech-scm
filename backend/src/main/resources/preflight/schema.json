{
  "slug": "scm",
  "title": "供应配额批次比例校验",
  "fields": [
    {
      "key": "allocation_no",
      "label": "配额行编号",
      "type": "ID",
      "length": 200
    },
    {
      "key": "material",
      "label": "物料",
      "type": "ID",
      "length": 200
    },
    {
      "key": "supplier",
      "label": "供应商",
      "type": "ID",
      "length": 200
    },
    {
      "key": "share",
      "label": "分配百分比",
      "type": "DECIMAL",
      "length": 200,
      "scale": 2,
      "max": "100"
    },
    {
      "key": "start_date",
      "label": "生效日期",
      "type": "DATE",
      "length": 200
    },
    {
      "key": "end_date",
      "label": "失效日期",
      "type": "DATE",
      "length": 200
    }
  ],
  "unique": [
    [
      "allocation_no"
    ],
    [
      "material",
      "supplier"
    ]
  ],
  "rules": [
    {
      "op": "GROUP_SUM",
      "args": [
        "material",
        "share",
        "100"
      ],
      "code": "QUOTA_SUM",
      "message": "同一物料在本批次的配额比例合计必须为100",
      "bad": {
        "share": "99"
      }
    },
    {
      "op": "DATE_LE",
      "args": [
        "start_date",
        "end_date"
      ],
      "code": "QUOTA_DATE",
      "message": "配额失效日期不得早于生效日期",
      "bad": {
        "end_date": "2026-01-01"
      }
    }
  ],
  "sampleCsv": "allocation_no,material,supplier,share,start_date,end_date\nAL-001,MAT-001,SUP-01,100,2026-11-01,2027-12-31\n",
  "limits": {
    "rows": 500,
    "bytes": 262144,
    "columns": 32,
    "cellCharacters": 4000
  },
  "scope": "Read-only batch validation; no persistence, reference-master lookup or full production certification."
}
